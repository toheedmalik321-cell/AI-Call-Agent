# =============================================
# AI CallHub - Environment Variables (.env.example)
# Copy this file to `.env` and fill in your values
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# =============================================

# ---------- Server ----------
PORT=3000

# ---------- Database ----------
# MongoDB connection string (MongoDB Atlas recommended for production)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/ai-callhub?retryWrites=true&w=majority

# ---------- Auth ----------
# Any long random string (used to sign JWT tokens)
JWT_SECRET=change_this_to_a_long_random_string

# ---------- AI Providers ----------
# Google Gemini API key (primary AI) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API key (AI fallback) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ---------- Twilio (Voice Calls + Recording) ----------
# From Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# A Twilio-verified phone number (E.164 format, e.g. +12025550123)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Your own phone number to receive test calls (E.164)
MY_PHONE_NUMBER=+92XXXXXXXXXX

# ---------- Ngrok (for voice webhooks) ----------
# Public URL that tunnels to your local server.
# Start with:  ngrok http 3000   -> then paste the https URL here
NGROK_URL=https://your-tunnel.ngrok-free.app

# ---------- Email (Nodemailer) ----------
# Used for account verification / password reset
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# ---------- Stripe (Payments / Subscriptions) ----------
# Leave empty and set PAYMENT_MODE=mock to run without real Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------- Payment Mode ----------
# "mock"  -> payments simulated (no real Stripe charges)
# "live"  -> real Stripe payments enabled
PAYMENT_MODE=mock
