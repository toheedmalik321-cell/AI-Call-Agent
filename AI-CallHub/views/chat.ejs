
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Chat | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/assets/favicon.png">
    <link rel="stylesheet" href="/css/chat-polish.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        body {
            font-family: 'Inter', sans-serif;
        }

        .glass {
            background: rgba(11, 18, 32, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .chatScroll::-webkit-scrollbar {
            width: 6px;
        }

        .chatScroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .chatScroll::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.22);
            border-radius: 999px;
        }

        .chatScroll::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.35);
        }

        .new-chat-btn {
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                filter 0.25s ease;
        }

        .new-chat-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, 0.28);
            filter: brightness(1.06);
        }

        .new-chat-btn:active {
            transform: scale(0.98);
        }

        .session-item {
            transition:
                background 0.2s ease,
                border-color 0.2s ease;
        }

        .session-item:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .send-btn {
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .send-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
        }

        .input-box {
            transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                background 0.25s ease;
        }

        .input-box:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(59, 130, 246, 0.65);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.08);
        }

    </style>

</head>

<body class="bg-[#070B17] text-white min-h-screen overflow-hidden">

    <!-- Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">

        <div class="absolute top-0 left-1/4
                    w-96 h-96
                    bg-blue-600/10
                    rounded-full
                    blur-[120px]">
        </div>

        <div class="absolute bottom-0 right-1/4
                    w-96 h-96
                    bg-purple-600/10
                    rounded-full
                    blur-[120px]">
        </div>

    </div>

    <div class="flex h-screen">

        <!-- ================= SIDEBAR ================= -->

        <aside
            class="hidden md:flex
                   w-72
                   flex-col
                   bg-[#0B1220]/90
                   border-r border-white/10
                   backdrop-blur-xl">

            <!-- Brand -->

            <div class="px-6 py-6 border-b border-white/10">

                <a
                    href="/dashboard"
                    class="text-2xl font-extrabold tracking-tight">

                    <span class="text-blue-400">AI</span>
                    CallHub

                </a>

                <p class="text-xs text-slate-500 mt-1">
                    AI Assistant
                </p>

            </div>

            <!-- New Chat -->

            <div class="p-5">

                <button
                    id="newChatBtn"
                    class="new-chat-btn
                           w-full
                           bg-gradient-to-r
                           from-blue-600
                           to-blue-500
                           hover:from-blue-500
                           hover:to-blue-400
                           rounded-xl
                           py-3
                           font-semibold
                           shadow-lg
                           shadow-blue-500/20">

                    ＋ New Chat

                </button>

            </div>

            <!-- Sessions -->

            <div class="px-5 mb-3">

                <p class="text-xs
                          uppercase
                          tracking-widest
                          text-slate-600
                          font-semibold">

                    Conversations

                </p>

            </div>

            <div
                id="chatSessions"
                class="flex-1 overflow-y-auto chatScroll px-4 space-y-2">

                <!-- Sessions loaded by JS -->

            </div>

            <!-- Dashboard -->

            <div class="p-5 border-t border-white/10">

                <a
                    href="/dashboard"
                    class="block w-full
                           text-center
                           bg-white/[0.05]
                           border border-white/10
                           hover:bg-white/[0.08]
                           rounded-xl
                           py-3
                           text-sm
                           text-slate-300
                           transition">

                    ← Dashboard

                </a>

            </div>

        </aside>

        <!-- ================= MAIN CHAT ================= -->

        <main class="flex-1 flex flex-col min-w-0">

            <!-- Header -->

            <header
                class="h-20
                       shrink-0
                       flex items-center
                       px-5 md:px-8
                       border-b border-white/10
                       bg-[#0B1220]/70
                       backdrop-blur-xl">

                <div class="flex items-center gap-3">

                    <div
                        class="w-11 h-11
                               rounded-xl
                               bg-blue-500/10
                               border border-blue-500/20
                               flex items-center justify-center
                               text-xl">

                        🤖

                    </div>

                    <div>

                        <h1 class="font-semibold text-lg">
                            AI Chat Assistant
                        </h1>

                        <div class="flex items-center gap-2">

                            <span
                                class="w-1.5 h-1.5
                                       rounded-full
                                       bg-green-400
                                       animate-pulse">
                            </span>

                            <p class="text-xs text-slate-500">
                                Ask anything from your active Knowledge Base
                            </p>

                        </div>

                    </div>

                </div>

            </header>

            <!-- Chat Log -->

            <div
                id="chatLog"
                class="flex-1
                       overflow-y-auto
                       chatScroll
                       px-5 md:px-10
                       py-8
                       space-y-5">

                <!-- Empty State -->

                <div
                    class="min-h-full
                           flex
                           flex-col
                           items-center
                           justify-center
                           text-center
                           pb-16">

                    <div
                        class="w-24 h-24
                               rounded-full
                               bg-gradient-to-br
                               from-blue-600
                               to-purple-600
                               flex items-center
                               justify-center
                               text-5xl
                               shadow-2xl
                               shadow-blue-600/20">

                        🤖

                    </div>

                    <h2
                        class="text-3xl md:text-4xl
                               font-bold
                               mt-8">

                        Welcome to AI CallHub

                    </h2>

                    <p
                        class="text-slate-400
                               mt-4
                               max-w-xl
                               leading-7">

                        Start a new conversation with your AI Assistant.
                        The assistant will answer only from your currently
                        Active Knowledge Base.

                    </p>

                    <div
                        class="mt-6
                               px-4 py-2
                               rounded-full
                               bg-blue-500/5
                               border border-blue-500/10
                               text-xs
                               text-slate-500">

                        📚 Powered by your active knowledge

                    </div>

                </div>

            </div>

            <!-- ================= INPUT ================= -->

<div
    class="shrink-0
           px-4 md:px-8
           py-5
           border-t border-white/10
           bg-[#0B1220]/80
           backdrop-blur-xl">

    <div class="max-w-5xl mx-auto">

        <form
            id="chatForm"
            class="flex items-end gap-3
                   glass
                   rounded-2xl
                   p-2">

            <!-- Microphone -->
            <button
                id="micBtn"
                type="button"
                class="w-11 h-11
                       shrink-0
                       rounded-xl
                       bg-white/[0.04]
                       hover:bg-white/[0.08]
                       border border-white/10
                       flex items-center justify-center
                       text-lg
                       transition">

                🎤

            </button>

            <!-- Message Input -->
            <textarea
                id="chatInput"
                rows="1"
                placeholder="Ask your AI Assistant..."
                class="input-box
                       flex-1
                       resize-none
                       bg-transparent
                       border border-transparent
                       rounded-xl
                       px-4 py-3
                       text-white
                       placeholder:text-slate-600
                       outline-none
                       min-h-[46px]">
            </textarea>

            <!-- Send Button -->
            <button
                id="sendBtn"
                type="submit"
                class="w-11 h-11
                       shrink-0
                       rounded-xl
                       bg-gradient-to-r
                       from-blue-600
                       to-blue-500
                       flex items-center
                       justify-center
                       shadow-lg
                       shadow-blue-500/20">

                ➤

            </button>

        </form>

        <p
            class="text-center
                   text-[11px]
                   text-slate-600
                   mt-3">

            AI responses are generated only from your
            active uploaded knowledge.

        </p>

    </div>

</div>
        </main>

    </div>
    <script src="/js/toast.js"></script>
<script src="/js/chat.js"></script>
</body>

</html>

