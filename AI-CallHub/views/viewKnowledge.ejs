<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<title>View Knowledge</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/view-knowledge-polish.css">


<link rel="stylesheet" href="/css/app-premium.css"></head>

<body class="bg-[#070B17] text-white">

<div class="app-aurora" aria-hidden="true">
    <div class="app-aurora__blob app-aurora__blob--1"></div>
    <div class="app-aurora__blob app-aurora__blob--2"></div>
</div>
<svg class="app-grain" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="appGrain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#appGrain)"/>
</svg>


<div class="flex flex-col lg:flex-row min-h-screen">

<%- include("components/app-sidebar", { active: "knowledge" }) %>

<div class="flex-1 min-w-0">

<div class="max-w-5xl mx-auto py-10">

<h1 class="text-4xl font-bold mb-8">
Knowledge Details
</h1>

<div class="glass rounded-2xl p-8">

<h2
id="title"
class="text-3xl font-bold">

Loading...

</h2>

<pre
id="content"
class="mt-6 whitespace-pre-wrap text-gray-300">

</pre>

</div>

</div>

</div>

</div>

<script src="/js/auth.js"></script>

<script src="/js/toast.js"></script>

<script>

const token = localStorage.getItem("token");

if (!token) {
    window.location = "/login";
}

const id = new URLSearchParams(window.location.search).get("id");

fetch("/api/knowledge", {

    headers: {
        Authorization: "Bearer " + token
    }

})

.then(res => res.json())

.then(data => {

    const file = data.data.find(x => x._id === id);

    if (!file) {

        toast("File not found");

        window.location = "/knowledge";

        return;
    }

    document.getElementById("title").innerText = file.title;

    document.getElementById("content").innerText = file.content;

})

.catch(err => {

    console.log(err);

    toast("Error loading knowledge.");

});

</script>


<script src="/js/app-premium.js"></script>
</body>

</html>