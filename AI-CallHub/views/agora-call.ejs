<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Agora AI Voice Call | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/assets/favicon.png">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(ellipse at top, #0f172a 0%, #020617 100%);
        }

        .glass {
            background: rgba(11, 18, 32, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 9999px;
            background: #64748b;
        }

        .status-dot.live {
            background: #22c55e;
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
            animation: pulse 2s infinite;
        }

        .status-dot.ringing {
            background: #f59e0b;
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.6);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
            70% { box-shadow: 0 0 0 12px rgba(34, 197, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }

        @keyframes pulseRing {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.55); }
            70% { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }

        .status-dot.ringing { animation: pulseRing 2s infinite; }

        .call-btn {
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }
        .call-btn:hover { transform: translateY(-2px); filter: brightness(1.06); }
        .call-btn:active { transform: scale(0.97); }
        .call-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .transcriptScroll::-webkit-scrollbar { width: 6px; }
        .transcriptScroll::-webkit-scrollbar-track { background: transparent; }
        .transcriptScroll::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.22);
            border-radius: 999px;
        }

        .msg-in, .msg-out {
            animation: slideIn 0.25s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .typing-dot {
            width: 7px; height: 7px; border-radius: 9999px;
            background: #94a3b8;
            display: inline-block;
            animation: blink 1.4s infinite both;
        }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }

        @keyframes blink {
            0%, 80%, 100% { opacity: 0.2; transform: translateY(0); }
            40% { opacity: 1; transform: translateY(-3px); }
        }

    </style>

</head>

<body class="min-h-screen text-slate-100">

    <!-- ===== Top Bar ===== -->
    <header class="border-b border-white/10 bg-slate-950/70 backdrop-blur sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">

            <div class="flex items-center gap-3">
                <a href="/dashboard" class="flex items-center gap-2">
                    <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                        AI CallHub
                    </span>
                </a>
                <span class="hidden sm:inline-block text-xs px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300">
                    Agora Real-time Voice
                </span>
            </div>

            <nav class="flex items-center gap-2 text-sm">
                <a href="/calls" class="px-3 py-2 rounded-lg text-slate-300 hover:bg-white/5 hover:text-white transition">Calls</a>
                <a href="/chat" class="px-3 py-2 rounded-lg text-slate-300 hover:bg-white/5 hover:text-white transition">AI Chat</a>
                <a href="/dashboard" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-white transition">Dashboard</a>
            </nav>

        </div>
    </header>

    <!-- ===== Main ===== -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">

        <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-extrabold">
                Agora AI Voice Call
            </h1>
            <p class="mt-2 text-slate-400">
                Real-time voice call with your activated AI agent — powered by Agora RTC + Gemini.
            </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-6">

            <!-- ===== Left: Call Controls ===== -->
            <div class="glass rounded-2xl p-6 lg:col-span-1">

                <!-- Status -->
                <div class="flex items-center justify-between mb-6">
                    <span class="text-sm text-slate-400">Call Status</span>
                    <div class="flex items-center gap-2">
                        <span id="statusDot" class="status-dot"></span>
                        <span id="statusText" class="text-sm font-medium text-slate-200">Idle</span>
                    </div>
                </div>

                <!-- Avatar (agent) -->
                <div class="text-center my-6">
                    <div id="agentAvatar" class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-4xl font-bold shadow-2xl shadow-blue-500/20">
                        AI
                    </div>
                    <div id="agentName" class="mt-3 text-lg font-semibold">AI Agent</div>
                    <div id="agentRole" class="text-sm text-slate-400">Receptionist</div>
                </div>

                <!-- Controls -->
                <div class="space-y-3">

                    <label class="block">
                        <span class="text-xs text-slate-400">Customer Name</span>
                        <input id="customerName" type="text" value="Walk-in Customer"
                               class="mt-1 w-full bg-slate-900/60 border border-white/10 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                    </label>

                    <label class="block">
                        <span class="text-xs text-slate-400">Your Phone (optional)</span>
                        <input id="phoneNumber" type="text" placeholder="+92..."
                               class="mt-1 w-full bg-slate-900/60 border border-white/10 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                    </label>

                    <div class="rounded-xl bg-slate-900/60 border border-white/10 p-3 flex items-center gap-2">
                        <span id="channelStatus" class="text-sm text-slate-400">Agora channel not connected</span>
                    </div>

                    <button id="startCallBtn" class="call-btn w-full bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl py-3 font-semibold shadow-lg shadow-blue-600/20">
                        📞 Start AI Voice Call
                    </button>

                    <button id="endCallBtn" class="call-btn w-full bg-red-600/80 text-white rounded-xl py-3 font-semibold shadow-lg shadow-red-600/10" disabled>
                        📵 End Call
                    </button>

                </div>

                <div id="infoBox" class="mt-4 text-xs text-slate-500 leading-relaxed">
                    Tip: Speak naturally. Say "bye" or "goodbye" to end the call and generate a summary.
                </div>

            </div>

            <!-- ===== Right: Transcript ===== -->
            <div class="glass rounded-2xl p-6 lg:col-span-2 flex flex-col">

                <div class="flex items-center justify-between mb-4">
                    <h2 class="font-semibold">Live Transcript</h2>
                    <button id="clearTransBtn" class="text-xs text-slate-400 hover:text-white transition">Clear</button>
                </div>

                <div id="transcript" class="transcriptScroll flex-1 min-h-[420px] max-h-[520px] overflow-y-auto space-y-3 pr-2 rounded-xl">

                    <div class="text-center text-slate-500 text-sm mt-8" id="emptyTranscript">
                        Start a call to begin the AI voice conversation.
                    </div>

                </div>

            </div>

        </div>

    </main>

    <!-- ===== Scripts ===== -->
    <script src="https://download.agora.io/sdk/release/AgoraRTC_N-4.22.0.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/agora-call.js"></script>

</body>
</html>