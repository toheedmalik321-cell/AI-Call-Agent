<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>404 - Page Not Found | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/assets/favicon.png">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(ellipse at top, #0f172a 0%, #020617 100%);
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center text-slate-100 px-6">

    <div class="text-center max-w-lg">

        <div
            class="text-[110px] leading-none font-extrabold
                   bg-gradient-to-br from-teal-400 to-emerald-500
                   bg-clip-text text-transparent">
            404
        </div>

        <h1 class="mt-4 text-2xl sm:text-3xl font-bold text-white">
            Page Not Found
        </h1>

        <p class="mt-3 text-slate-400 text-sm sm:text-base leading-relaxed">
            The page you are looking for doesn't exist,
            was moved, or you may have followed an old link.
        </p>

        <div class="mt-8 flex items-center justify-center gap-3">

            <a
                href="/"
                class="px-6 py-3 rounded-xl font-semibold
                       bg-gradient-to-r from-teal-600 to-teal-500
                       hover:from-teal-500 hover:to-teal-400
                       text-white transition">
                Go to Home
            </a>

            <a
                href="/dashboard"
                class="px-6 py-3 rounded-xl font-semibold
                       bg-white/5 border border-white/10
                       hover:bg-white/10 text-slate-200 transition">
                Dashboard
            </a>

        </div>

    </div>

</body>

</html>
