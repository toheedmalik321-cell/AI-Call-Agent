<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Call Details</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/call-details-polish.css">


<link rel="stylesheet" href="/css/app-premium.css"></head>

<body class="bg-[#070B17] text-white">

<div class="app-aurora" aria-hidden="true">
    <div class="app-aurora__blob app-aurora__blob--1"></div>
    <div class="app-aurora__blob app-aurora__blob--2"></div>
</div>
<svg class="app-grain" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="appGrain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#appGrain)"/>
</svg>


<div class="max-w-5xl mx-auto py-10">

    <div class="flex justify-between items-center mb-8">

        <h1 class="text-4xl font-bold">
            Call Details
        </h1>

        <a
            href="/calls"
            class="bg-teal-600 hover:bg-teal-700 px-5 py-3 rounded-xl">

            ← Back

        </a>

    </div>

    <div class="glass rounded-2xl p-8 space-y-8">

        <div>

            <h2 class="text-xl font-bold mb-2">
                Customer Name
            </h2>

            <p id="customerName" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Phone Number
            </h2>

            <p id="phoneNumber" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                AI Agent
            </h2>

            <p id="agentName" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Agent Role
            </h2>

            <p id="agentRole" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Status
            </h2>

            <p id="status" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Duration
            </h2>

            <p id="duration" class="text-gray-300"></p>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Customer Message
            </h2>

            <div class="bg-[#111827] rounded-xl p-4">
                <p id="customerMessage"></p>
            </div>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                AI Reply
            </h2>

            <div class="bg-[#111827] rounded-xl p-4">
                <p id="aiReply"></p>
            </div>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Call Summary
            </h2>

            <div class="bg-[#111827] rounded-xl p-4">
                <p id="summary" class="whitespace-pre-wrap"></p>
            </div>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Call Recording
            </h2>

            <div id="recordingBox"
                 class="bg-[#111827] rounded-xl p-4">
                Loading recording...
            </div>

        </div>

        <div>

            <h2 class="text-xl font-bold mb-2">
                Transcript
            </h2>

            <div class="bg-[#111827] rounded-xl p-4">
                <p id="transcript" class="whitespace-pre-wrap"></p>
            </div>

        </div>

    </div>

</div>

    <script src="/js/toast.js"></script>
<script src="/js/call-details.js"></script>


<script src="/js/app-premium.js"></script>
</body>

</html>