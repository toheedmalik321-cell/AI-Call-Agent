
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/login-polish.css">
    <link rel="icon" href="/assets/favicon.png">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .login-card {
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.09);
            box-shadow:
                0 25px 80px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }

        .input-field {
            transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                background 0.25s ease;
        }

        .input-field:focus {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(59, 130, 246, 0.8);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
        }

        .login-btn {
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                filter 0.25s ease;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 35px rgba(37, 99, 235, 0.30);
            filter: brightness(1.08);
        }

        .login-btn:active {
            transform: translateY(0) scale(0.98);
        }

        .glow {
            pointer-events: none;
        }
    </style>
</head>

<body class="bg-[#070B17] text-white min-h-screen overflow-hidden">

    <!-- Background -->
    <div class="fixed inset-0 overflow-hidden glow">

        <div class="absolute inset-0 bg-gradient-to-br from-[#070B17] via-[#0B1120] to-[#080B18]"></div>

        <div class="absolute top-10 left-10 w-80 h-80 rounded-full bg-blue-600/15 blur-[110px]"></div>

        <div class="absolute bottom-0 right-10 w-96 h-96 rounded-full bg-purple-600/15 blur-[120px]"></div>

        <div class="absolute top-1/2 left-1/2 w-72 h-72 rounded-full bg-cyan-500/5 blur-[100px]"></div>

    </div>

    <!-- Main -->
    <main class="relative z-10 min-h-screen flex items-center justify-center px-5 py-10">

        <div class="w-full max-w-md">

            <!-- Brand -->
            <div class="text-center mb-7">

                <a href="/" class="inline-block text-2xl font-extrabold tracking-tight">
                    <span class="text-blue-400">AI</span> CallHub
                </a>

                <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-500">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                    AI-powered voice platform
                </div>

            </div>

            <!-- Login Card -->
            <div class="login-card rounded-3xl p-7 sm:p-9">

                <!-- Header -->
                <div class="text-center mb-8">

                    <div class="mx-auto mb-5 w-14 h-14 rounded-2xl
                                bg-blue-500/10
                                border border-blue-500/20
                                flex items-center justify-center
                                text-2xl shadow-lg shadow-blue-500/10">
                        🔐
                    </div>

                    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
                        Welcome Back
                    </h1>

                    <p class="text-slate-400 mt-2">
                        Login to your AI CallHub account
                    </p>

                </div>

                <!-- Form -->
                <form id="loginForm" class="space-y-5">

                    <!-- Email -->
                    <div>

                        <label
                            for="email"
                            class="block mb-2 text-sm font-medium text-slate-300">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            autocomplete="email"
                            placeholder="you@example.com"
                            class="input-field w-full rounded-xl
                                   bg-white/[0.04]
                                   border border-white/10
                                   px-4 py-3.5
                                   text-white placeholder:text-slate-600
                                   outline-none"
                        >

                    </div>

                    <!-- Password -->
                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <label
                                for="password"
                                class="text-sm font-medium text-slate-300">
                                Password
                            </label>

                            <a
                                href="/forgot-password"
                                class="text-xs font-medium text-blue-400 hover:text-blue-300 transition">
                                Forgot Password?
                            </a>

                        </div>

                        <input
                            type="password"
                            id="password"
                            autocomplete="current-password"
                            placeholder="Enter your password"
                            class="input-field w-full rounded-xl
                                   bg-white/[0.04]
                                   border border-white/10
                                   px-4 py-3.5
                                   text-white placeholder:text-slate-600
                                   outline-none"
                        >

                    </div>

                    <!-- Login Button -->
                    <button
                        type="submit"
                        class="login-btn w-full
                               bg-gradient-to-r from-blue-600 to-blue-500
                               hover:from-blue-500 hover:to-blue-400
                               rounded-xl py-3.5
                               font-semibold
                               shadow-lg shadow-blue-500/20
                               flex items-center justify-center gap-2">

                        <span>Login</span>
                        <span>→</span>

                    </button>

                </form>

                <!-- Message -->
                <div
                    id="msg"
                    class="mt-5 text-center text-sm min-h-[20px]">
                </div>

                <!-- Divider -->
                <div class="flex items-center gap-3 my-6">

                    <div class="h-px flex-1 bg-white/10"></div>

                    <span class="text-xs text-slate-600">
                        NEW TO AI CALLHUB?
                    </span>

                    <div class="h-px flex-1 bg-white/10"></div>

                </div>

                <!-- Register -->
                <div class="text-center">

                    <p class="text-sm text-slate-400">
                        Don't have an account?

                        <a
                            href="/register"
                            class="ml-1 text-blue-400 hover:text-blue-300 font-semibold transition">
                            Sign Up
                        </a>
                    </p>

                </div>

            </div>

            <!-- Footer -->
            <p class="text-center text-xs text-slate-600 mt-6">
                Secure authentication · AI CallHub
            </p>

        </div>

    </main>

    <script src="/js/login.js"></script>

</body>

</html>

