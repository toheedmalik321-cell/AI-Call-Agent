
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit AI Agent | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/assets/favicon.png">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        body {
            font-family: 'Inter', sans-serif;
        }

        .glass-card {
            background: rgba(11, 18, 32, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow:
                0 25px 70px rgba(0, 0, 0, 0.28),
                inset 0 1px 0 rgba(255, 255, 255, 0.03);
        }

        .field {
            transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                background 0.25s ease;
        }

        .field:focus {
            background: rgba(17, 24, 39, 0.95);
            border-color: rgba(59, 130, 246, 0.8);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.10);
        }

        .action-btn {
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                filter 0.25s ease;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 35px rgba(37, 99, 235, 0.28);
            filter: brightness(1.06);
        }

        .action-btn:active {
            transform: scale(0.98);
        }

        .back-btn {
            transition:
                border-color 0.25s ease,
                background 0.25s ease,
                transform 0.25s ease;
        }

        .back-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(59, 130, 246, 0.5);
            background: rgba(30, 41, 59, 0.8);
        }

        .cancel-btn {
            transition:
                border-color 0.25s ease,
                background 0.25s ease;
        }

        .cancel-btn:hover {
            border-color: rgba(248, 113, 113, 0.5);
            background: rgba(127, 29, 29, 0.12);
        }

    </style>

</head>

<body class="bg-[#070B17] text-white min-h-screen overflow-x-hidden">

    <!-- Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">

        <div class="absolute inset-0 bg-gradient-to-br
                    from-[#070B17]
                    via-[#0B1120]
                    to-[#080B18]">
        </div>

        <div class="absolute top-0 left-1/4
                    w-96 h-96
                    bg-blue-600/10
                    rounded-full
                    blur-[120px]">
        </div>

        <div class="absolute bottom-0 right-1/4
                    w-96 h-96
                    bg-purple-600/10
                    rounded-full
                    blur-[120px]">
        </div>

    </div>

    <!-- Main -->
    <main class="max-w-4xl mx-auto px-5 sm:px-6 py-10 sm:py-14">

        <!-- Header -->
        <div class="flex flex-col md:flex-row
                    justify-between
                    items-start md:items-center
                    gap-5 mb-10">

            <div>

                <div class="flex items-center gap-2 mb-3">

                    <span class="w-2 h-2 rounded-full bg-blue-400"></span>

                    <span class="text-blue-400
                                 text-xs
                                 font-semibold
                                 uppercase
                                 tracking-[0.2em]">
                        AI CallHub
                    </span>

                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">

                    ✏️ Edit AI Agent

                </h1>

                <p class="text-slate-400 mt-2">
                    Update your AI voice assistant settings.
                </p>

            </div>

            <a
                href="/agents"
                class="back-btn
                       inline-flex
                       items-center
                       gap-2
                       px-5 py-3
                       rounded-xl
                       bg-[#0B1220]
                       border border-white/10
                       text-slate-300
                       hover:text-white">

                <span>←</span>
                <span>Back to Agents</span>

            </a>

        </div>

        <!-- Form Card -->
        <form
            id="agentForm"
            autocomplete="off"
            class="glass-card
                   rounded-3xl
                   p-6 sm:p-8
                   space-y-7">

            <input type="hidden" id="agentId">

            <!-- Form Intro -->
            <div class="pb-6 border-b border-white/10">

                <h2 class="text-xl font-semibold">
                    Agent Configuration
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Modify the details below and save your changes.
                </p>

            </div>

            <!-- Company -->
            <div>

                <label
                    for="companyName"
                    class="block mb-2 text-sm font-semibold text-slate-300">

                    🏢 Company Name

                </label>

                <input
                    id="companyName"
                    type="text"
                    required
                    placeholder="Enter company name..."
                    class="field
                           w-full
                           px-4 py-3.5
                           rounded-xl
                           bg-[#111827]
                           border border-white/10
                           text-white
                           placeholder:text-slate-600
                           outline-none">

            </div>

            <!-- Role -->
            <div>

                <label
                    for="role"
                    class="block mb-2 text-sm font-semibold text-slate-300">

                    💼 Agent Role

                </label>

                <select
                    id="role"
                    class="field
                           w-full
                           px-4 py-3.5
                           rounded-xl
                           bg-[#111827]
                           border border-white/10
                           text-white
                           outline-none">

                    <option value="receptionist">
                        Receptionist
                    </option>

                    <option value="sales">
                        Sales
                    </option>

                    <option value="support">
                        Support
                    </option>

                </select>

            </div>

            <!-- Voice -->
            <div>

                <label
                    for="voice"
                    class="block mb-2 text-sm font-semibold text-slate-300">

                    🎙 AI Voice

                </label>

                <select
                    id="voice"
                    class="field
                           w-full
                           px-4 py-3.5
                           rounded-xl
                           bg-[#111827]
                           border border-white/10
                           text-white
                           outline-none">

                    <option value="alice">
                        Alice (Natural Female)
                    </option>

                    <option value="man">
                        Male Voice
                    </option>

                    <option value="woman">
                        Female Voice
                    </option>

                </select>

            </div>

            <!-- Instructions -->
            <div>

                <div class="flex items-center justify-between mb-2">

                    <label
                        for="instructions"
                        class="text-sm font-semibold text-slate-300">

                        🤖 AI Instructions

                    </label>

                    <span class="text-xs text-slate-600">
                        Voice behavior
                    </span>

                </div>

                <textarea
                    id="instructions"
                    rows="8"
                    placeholder="Update AI instructions..."
                    class="field
                           w-full
                           px-4 py-4
                           rounded-xl
                           bg-[#111827]
                           border border-white/10
                           text-white
                           placeholder:text-slate-600
                           outline-none
                           resize-none
                           leading-6"></textarea>

            </div>

            <!-- Buttons -->
            <div class="pt-2 flex flex-col sm:flex-row gap-3">

                <button
                    type="submit"
                    class="action-btn
                           flex-1
                           bg-gradient-to-r
                           from-blue-600
                           to-blue-500
                           hover:from-blue-500
                           hover:to-blue-400
                           py-3.5
                           rounded-xl
                           font-semibold
                           shadow-lg
                           shadow-blue-500/20
                           flex items-center
                           justify-center
                           gap-2">

                    <span>💾</span>
                    <span>Save Changes</span>

                </button>

                <a
                    href="/agents"
                    class="cancel-btn
                           sm:px-7
                           py-3.5
                           rounded-xl
                           border border-white/10
                           bg-[#111827]
                           text-slate-300
                           hover:text-white
                           text-center">

                    Cancel

                </a>

            </div>

        </form>

        <!-- Footer Note -->
        <p class="text-center text-xs text-slate-600 mt-6">
            Changes will apply to this AI agent configuration.
        </p>

    </main>

</body>

</html>

