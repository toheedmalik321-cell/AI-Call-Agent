
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Knowledge Base | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" href="/assets/favicon.png">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        body {
            font-family: 'Inter', sans-serif;
        }

        .glass {
            background: rgba(11, 18, 32, 0.72);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.20),
                inset 0 1px 0 rgba(255, 255, 255, 0.03);
        }

        .upload-btn {
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                filter 0.25s ease;
        }

        .upload-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, 0.28);
            filter: brightness(1.06);
        }

        .upload-btn:active {
            transform: scale(0.98);
        }

        .knowledge-wrapper {
            transition:
                border-color 0.25s ease,
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .knowledge-wrapper:hover {
            transform: translateY(-3px);
            border-color: rgba(96, 165, 250, 0.22);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
        }

    </style>

</head>

<body class="bg-[#070B17] text-white min-h-screen overflow-x-hidden">

    <!-- Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">

        <div class="absolute inset-0 bg-gradient-to-br
                    from-[#070B17]
                    via-[#0B1120]
                    to-[#080B18]">
        </div>

        <div class="absolute top-0 left-1/4
                    w-96 h-96
                    bg-blue-600/10
                    rounded-full
                    blur-[120px]">
        </div>

        <div class="absolute bottom-0 right-1/4
                    w-96 h-96
                    bg-purple-600/10
                    rounded-full
                    blur-[120px]">
        </div>

    </div>

    <!-- Main -->
    <main class="max-w-6xl mx-auto px-5 sm:px-6 py-10 sm:py-12">

        <!-- Header -->
        <div class="flex flex-col md:flex-row
                    md:items-center
                    md:justify-between
                    gap-5 mb-10">

            <div>

                <div class="flex items-center gap-2 mb-3">

                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>

                    <span class="text-blue-400
                                 text-xs
                                 font-semibold
                                 uppercase
                                 tracking-[0.2em]">
                        AI CallHub
                    </span>

                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
                    📚 Knowledge Base
                </h1>

                <p class="text-slate-400 mt-2">
                    Upload and manage documents used by your AI agents.
                </p>

            </div>

            <a
                href="/add-knowledge"
                class="upload-btn
                       inline-flex
                       items-center
                       justify-center
                       gap-2
                       bg-gradient-to-r
                       from-blue-600
                       to-blue-500
                       hover:from-blue-500
                       hover:to-blue-400
                       px-6
                       py-3
                       rounded-xl
                       font-semibold
                       shadow-lg
                       shadow-blue-500/20">

                <span>📤</span>
                <span>Upload File</span>

            </a>

        </div>

        <!-- Info Card -->
        <div class="glass rounded-2xl p-5 mb-7">

            <div class="flex items-start gap-4">

                <div class="w-11 h-11
                            rounded-xl
                            bg-blue-500/10
                            border border-blue-500/20
                            flex items-center
                            justify-center
                            text-xl
                            shrink-0">

                    📄

                </div>

                <div>

                    <h2 class="font-semibold text-white">
                        Your AI Knowledge
                    </h2>

                    <p class="text-sm text-slate-400 mt-1">
                        These files can provide your AI agents with
                        business information, FAQs, policies and other
                        useful context.
                    </p>

                </div>

            </div>

        </div>

        <!-- Knowledge List -->
        <div
            id="knowledgeList"
            class="grid md:grid-cols-2 gap-6">

            <!-- Knowledge files are loaded by JavaScript -->

        </div>

    </main>
<script src="/js/knowledge.js"></script>
</body>

</html>

