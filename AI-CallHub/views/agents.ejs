<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Design and manage your AI voice agents with personality, workflow and knowledge base controls.">
    <meta name="theme-color" content="#04070c">
    <link rel="canonical" href="https://ai-call-agent-qlee.onrender.com/agents">
    <meta name="robots" content="noindex, nofollow">
    
    <meta property="og:title" content="Agents — AI CallHub">
    <meta property="og:description" content="Design and manage your AI voice agents with personality, workflow and knowledge base controls.">
    <meta property="og:type" content="website">

<title>Agents — AI CallHub</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="/css/main.css">
<link rel="icon" href="/assets/favicon.png">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: "Inter", sans-serif;
        background:
            radial-gradient(circle at 15% 10%, rgba(13,148,136,.12), transparent 28%),
            radial-gradient(circle at 85% 85%, rgba(16,185,129,.10), transparent 30%),
            #070b17;
    }

    .glass {
        background: rgba(15,23,42,.62);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: 0 12px 40px rgba(0,0,0,.14);
    }

    .glass:hover {
        border-color: rgba(255,255,255,.12);
    }

    .sidebar-link {
        color: #94a3b8;
        border: 1px solid transparent;
        transition: all .25s ease;
    }

    .sidebar-link:hover {
        background: rgba(20,184,166,.08);
        color: #99f6e4;
        transform: translateX(4px);
    }

    .sidebar-link.active {
        background: linear-gradient(
            135deg,
            rgba(20,184,166,.18),
            rgba(20,184,166,.06)
        );
        color: #2dd4bf;
        border-color: rgba(20,184,166,.20);
        box-shadow: 0 8px 25px rgba(13,148,136,.10);
    }

    .stat-card {
        transition: all .3s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        border-color: rgba(45,212,191,.25);
        box-shadow: 0 20px 45px rgba(0,0,0,.20);
    }

    .agent-card {
        transition: all .3s ease;
    }

    .agent-card:hover {
        transform: translateY(-4px);
        border-color: rgba(45,212,191,.25);
        box-shadow: 0 20px 45px rgba(0,0,0,.22);
    }

    .create-btn {
        box-shadow:
            0 10px 30px rgba(13,148,136,.20),
            inset 0 1px 0 rgba(255,255,255,.12);
    }

    input {
        transition: all .25s ease;
    }

    input:focus {
        box-shadow: 0 0 0 3px rgba(20,184,166,.10);
    }

    ::-webkit-scrollbar {
        width: 7px;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(148,163,184,.22);
        border-radius: 999px;
    }

    @media(max-width:768px) {
        aside {
            width: 100%;
        }
    }
</style>
<link rel="stylesheet" href="/css/agents-polish.css">
<link rel="stylesheet" href="/css/app-premium.css">

</head>

<body class="text-white min-h-screen">

<div class="app-aurora" aria-hidden="true">
    <div class="app-aurora__blob app-aurora__blob--1"></div>
    <div class="app-aurora__blob app-aurora__blob--2"></div>
</div>
<svg class="app-grain" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="appGrain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#appGrain)"/>
</svg>


<!-- Background -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96
                bg-teal-500/10 rounded-full blur-3xl"></div>

    <div class="absolute bottom-0 right-1/4 w-96 h-96
                bg-emerald-500/10 rounded-full blur-3xl"></div>
</div>

<div class="flex flex-col lg:flex-row min-h-screen">

    <!-- SIDEBAR -->
    <%- include("components/app-sidebar", { active: "agents" }) %>

    <!-- MAIN -->
    <main class="flex-1 p-6 md:p-8 overflow-y-auto">

        <!-- HEADER -->
        <div class="flex flex-col md:flex-row
                    md:items-center md:justify-between
                    gap-5 mb-8">

            <div>
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl
                                bg-teal-500/10
                                flex items-center justify-center text-2xl">
                        🤖
                    </div>

                    <div>
                        <h1 class="text-3xl md:text-4xl font-extrabold">
                            AI Agents
                        </h1>

                        <p class="text-slate-400 mt-1">
                            Create and manage your AI voice agents.
                        </p>
                    </div>
                </div>
            </div>

            <a href="/add-agent"
               class="create-btn bg-gradient-to-r
                      from-teal-600 to-teal-500
                      hover:from-teal-500 hover:to-teal-400
                      px-6 py-3 rounded-xl font-semibold
                      transition hover:scale-[1.03]
                      active:scale-95 inline-flex
                      items-center justify-center gap-2">
                ➕ Create AI Agent
            </a>

        </div>

        <!-- SEARCH -->
        <div class="glass rounded-2xl p-4 mb-7">

            <div class="relative">

                <span class="absolute left-4 top-1/2
                             -translate-y-1/2 text-slate-500">
                    🔍
                </span>

                <input
                    type="text"
                    id="searchAgent"
                    placeholder="Search agents..."
                    class="w-full bg-[#0b1220]/80
                           border border-white/10
                           rounded-xl pl-11 pr-5 py-3.5
                           outline-none
                           focus:border-teal-500
                           text-white placeholder-slate-500">

            </div>

        </div>

        <!-- STATS -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">
                    Total Agents
                </p>

                <h2 id="totalAgents"
                    class="text-3xl font-bold mt-2">
                    0
                </h2>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">
                    Active
                </p>

                <h2 id="activeAgents"
                    class="text-3xl font-bold text-green-400 mt-2">
                    0
                </h2>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">
                    Inactive
                </p>

                <h2 id="inactiveAgents"
                    class="text-3xl font-bold text-red-400 mt-2">
                    0
                </h2>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">
                    Today's Calls
                </p>

                <h2 id="todayCalls"
                    class="text-3xl font-bold text-teal-300 mt-2">
                    0
                </h2>
            </div>

        </div>

        <!-- AGENTS SECTION -->
        <div class="glass rounded-2xl p-6">

            <div class="flex items-center justify-between mb-6">

                <div>
                    <h2 class="text-xl font-bold">
                        Your AI Agents
                    </h2>

                    <p class="text-sm text-slate-500 mt-1">
                        Manage your voice assistants
                    </p>
                </div>

                <a href="/add-agent"
                   class="text-sm text-teal-300
                          hover:text-teal-200">
                    + New Agent
                </a>

            </div>

            <!-- IMPORTANT:
                 Keep the container ID your existing
                 agents.js expects here.
                 If your current file already has an
                 agent container, keep that exact ID.
            -->

            <div id="agentsList"
     class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">

                <div class="agent-card bg-white/[.025]
                            border border-white/[.06]
                            rounded-2xl p-5">

                    <div class="flex items-center justify-center
                                h-32 text-slate-600">
                        Loading agents...
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

<script src="/js/toast.js"></script>
<script src="/js/agents.js"></script>
<script src="/js/app-premium.js"></script>


</body>
</html>
