<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile | AI CallHub</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet" href="/css/main.css">

<link rel="stylesheet" href="/css/profile-polish.css">

<link rel="icon" href="/assets/favicon.png">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

</head>

<body class="bg-[#070B17] text-white min-h-screen overflow-x-hidden">

<!-- Background -->

<div class="fixed inset-0 -z-10 overflow-hidden">

    <div class="absolute top-0 left-1/4 w-[420px] h-[420px] rounded-full bg-blue-600/10 blur-[120px]"></div>

    <div class="absolute bottom-0 right-1/4 w-[420px] h-[420px] rounded-full bg-purple-600/10 blur-[120px]"></div>

</div>

<div class="max-w-6xl mx-auto px-6 py-12">

    <!-- Header -->

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10">

        <div>

            <span class="uppercase tracking-[4px] text-blue-400 text-sm font-semibold">
                AI CallHub
            </span>

            <h1 class="text-5xl font-extrabold mt-2 bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">

                My Profile

            </h1>

            <p class="text-slate-400 mt-3 text-lg">

                Manage your account information and security settings.

            </p>

        </div>

        <a href="/dashboard"

        class="mt-6 md:mt-0 px-6 py-3 rounded-2xl bg-[#111827] border border-white/10 hover:border-blue-500 hover:bg-[#172036] transition">

            ← Dashboard

        </a>

    </div>

    <div class="grid lg:grid-cols-2 gap-8">

        <!-- Profile Card -->

        <div class="bg-[#0B1220]/95 backdrop-blur-xl border border-white/10 rounded-3xl shadow-[0_0_60px_rgba(59,130,246,.12)] p-8">

            <div class="flex items-center gap-5 mb-8">

                <div class="w-20 h-20 rounded-full bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center text-3xl font-bold shadow-xl shadow-blue-600/30">

                    👤

                </div>

                <div>

                    <h2 class="text-2xl font-bold">

                        Profile Information

                    </h2>

                    <p class="text-slate-400">

                        Update your personal information.

                    </p>

                </div>

            </div>

            <div class="space-y-6">

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        👤 Full Name

                    </label>

                    <input
                    id="name"
                    type="text"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20">

                </div>

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        📧 Email Address

                    </label>

                    <input
                    id="email"
                    type="email"
                    readonly

                    class="w-full px-5 py-4 rounded-2xl bg-[#0F172A] border border-white/10 text-slate-500 cursor-not-allowed">

                </div>

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        📱 Phone Number

                    </label>

                    <input
                    id="phone"
                    type="text"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20">

                </div>

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        🏢 Company

                    </label>

                    <input
                    id="company"
                    type="text"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20">

                </div>

                <button

                id="saveBtn"

                class="w-full py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 font-bold text-lg transition hover:scale-[1.02] shadow-xl shadow-blue-600/30">

                    💾 Save Profile

                </button>

                <p

                id="msg"

                class="text-center text-sm mt-2">

                </p>

            </div>

        </div>

        <!-- Password Card -->

        <div class="bg-[#0B1220]/95 backdrop-blur-xl border border-white/10 rounded-3xl shadow-[0_0_60px_rgba(168,85,247,.12)] p-8">

            <div class="flex items-center gap-5 mb-8">

                <div class="w-20 h-20 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 flex items-center justify-center text-3xl shadow-xl shadow-purple-500/30">

                    🔒

                </div>

                <div>

                    <h2 class="text-2xl font-bold">

                        Security

                    </h2>

                    <p class="text-slate-400">

                        Change your account password.

                    </p>

                </div>

            </div>

            <div class="space-y-6">

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        Current Password

                    </label>

                    <input

                    type="password"

                    id="currentPassword"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-purple-500 focus:ring-4 focus:ring-purple-500/20">

                </div>

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        New Password

                    </label>

                    <input

                    type="password"

                    id="newPassword"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-purple-500 focus:ring-4 focus:ring-purple-500/20">

                </div>

                <div>

                    <label class="block mb-2 font-medium text-slate-300">

                        Confirm Password

                    </label>

                    <input

                    type="password"

                    id="confirmPassword"

                    class="w-full px-5 py-4 rounded-2xl bg-[#111827] border border-white/10 outline-none transition focus:border-purple-500 focus:ring-4 focus:ring-purple-500/20">

                </div>

                <button

                id="changePasswordBtn"

                class="w-full py-4 rounded-2xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 font-bold text-lg transition hover:scale-[1.02] shadow-xl shadow-purple-500/30">

                    🔐 Change Password

                </button>

                <p

                id="passwordMsg"

                class="text-center text-sm mt-2">

                </p>

            </div>

        </div>

    </div>

</div>

    <script src="/js/toast.js"></script>
<script src="/js/profile.js"></script>

</body>

</html>