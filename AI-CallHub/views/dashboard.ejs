<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | AI CallHub</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="/css/main.css">
<link rel="icon" href="/assets/favicon.png">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: "Inter", sans-serif;
        letter-spacing: -0.01em;
        background:
            radial-gradient(circle at 15% 10%, rgba(37, 99, 235, .12), transparent 28%),
            radial-gradient(circle at 85% 85%, rgba(124, 58, 237, .10), transparent 30%),
            #070b17;
    }

    .glass {
        background: rgba(15, 23, 42, .62);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, .07);
        box-shadow: 0 12px 40px rgba(0, 0, 0, .14);
    }

    .glass:hover {
        border-color: rgba(255, 255, 255, .12);
    }

    aside {
        box-shadow: 15px 0 45px rgba(0, 0, 0, .18);
    }

    .sidebar-link {
        border: 1px solid transparent;
        color: #94a3b8;
        transition: all .25s ease;
    }

    .sidebar-link:hover {
        background: rgba(59, 130, 246, .08);
        color: #bfdbfe;
        transform: translateX(4px);
    }

    .sidebar-link.active {
        background: linear-gradient(
            135deg,
            rgba(59, 130, 246, .18),
            rgba(59, 130, 246, .06)
        );
        color: #60a5fa;
        border-color: rgba(59, 130, 246, .20);
        box-shadow:
            0 8px 25px rgba(37, 99, 235, .10),
            inset 0 0 20px rgba(59, 130, 246, .04);
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        transition: all .3s ease;
    }

    .stat-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(255,255,255,.04),
            transparent 60%
        );
        pointer-events: none;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: rgba(96,165,250,.25);
        box-shadow: 0 20px 45px rgba(0,0,0,.22);
    }

    .quick-card {
        transition: all .3s ease;
    }

    .quick-card:hover {
        transform: translateY(-5px);
        background: rgba(255,255,255,.045);
    }

    .section-card {
        transition: all .3s ease;
    }

    .section-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255,255,255,.12);
        box-shadow: 0 20px 45px rgba(0,0,0,.20);
    }

    #startCall {
        box-shadow:
            0 10px 30px rgba(37,99,235,.20),
            inset 0 1px 0 rgba(255,255,255,.12);
    }

    .status-dot {
        box-shadow: 0 0 10px currentColor;
    }

    ::-webkit-scrollbar {
        width: 7px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(148,163,184,.22);
        border-radius: 999px;
    }

    @media (max-width: 768px) {
        aside {
            width: 100%;
            min-height: auto;
        }

        main {
            padding: 1.25rem;
        }

        #startCall {
            width: 100%;
            justify-content: center;
        }
    }
</style>
<link rel="stylesheet" href="/css/dashboard-polish.css">

</head>

<body class="text-white min-h-screen">


<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl"></div>
</div>

<div class="flex min-h-screen">

    <!-- SIDEBAR -->
    <aside class="w-64 shrink-0 bg-[#0b1220]/80 border-r border-white/10 p-5 flex flex-col backdrop-blur-xl">

        <a href="/dashboard"
           class="text-2xl font-extrabold mb-10 tracking-tight px-2">
            <span class="text-blue-400">AI</span> CallHub
        </a>

        <nav class="space-y-2 flex-1">

            <a href="/dashboard"
               class="sidebar-link active flex items-center justify-between px-4 py-3 rounded-xl">
                <div class="flex items-center gap-3">
                    <span class="text-lg">📊</span>
                    <span class="font-medium">Dashboard</span>
                </div>
                <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
            </a>

            <a href="/agents"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">🤖</span>
                <span>AI Agents</span>
            </a>

            <a href="/knowledge"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">📚</span>
                <span>Knowledge Base</span>
            </a>

            <a href="/chat"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">💬</span>
                <span>AI Chat</span>
            </a>

            <a href="/calls"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">📞</span>
                <span>Calls</span>
            </a>

            <a href="/plans"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">💳</span>
                <span>Plans</span>
            </a>

            <a href="/profile"
               class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl">
                <span class="text-lg">👤</span>
                <span>Profile</span>
            </a>

        </nav>

        <button id="logoutBtn"
            class="mt-6 w-full bg-red-500/10 hover:bg-red-500/20
                   text-red-400 border border-red-500/20
                   px-5 py-3 rounded-xl font-medium transition">
            🚪 Logout
        </button>

    </aside>

    <!-- MAIN -->
    <main class="flex-1 p-6 md:p-8 overflow-y-auto">

        <!-- HEADER -->
        <div class="flex flex-col md:flex-row md:items-center
                    md:justify-between gap-5 mb-8">

            <div>
                <div class="flex items-center gap-3">
                    <h1 id="welcome"
                        class="text-3xl md:text-4xl font-extrabold tracking-tight">
                        Loading...
                    </h1>
                </div>

                <p class="text-slate-400 mt-2 flex items-center gap-2">
                    <span class="w-2 h-2 bg-green-400 rounded-full
                                 animate-pulse status-dot"></span>
                    Here's what's happening with your AI CallHub
                </p>
            </div>

            <button id="startCall"
                class="bg-gradient-to-r from-blue-600 to-blue-500
                       hover:from-blue-500 hover:to-blue-400
                       px-6 py-3 rounded-xl font-semibold
                       hover:scale-[1.03] active:scale-95
                       transition-all duration-300
                       flex items-center gap-2">
                📞 Start AI Call
            </button>

        </div>

        <!-- QUICK ACTIONS -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

            <a href="/agents"
               class="glass quick-card rounded-2xl p-5">
                <div class="w-11 h-11 rounded-xl bg-blue-500/10
                            flex items-center justify-center text-2xl mb-4">
                    🤖
                </div>
                <h3 class="font-semibold">Manage Agents</h3>
                <p class="text-sm text-slate-400 mt-1">
                    Create & manage AI agents
                </p>
            </a>

            <a href="/knowledge"
               class="glass quick-card rounded-2xl p-5">
                <div class="w-11 h-11 rounded-xl bg-green-500/10
                            flex items-center justify-center text-2xl mb-4">
                    📚
                </div>
                <h3 class="font-semibold">Knowledge Base</h3>
                <p class="text-sm text-slate-400 mt-1">
                    Upload PDFs & documents
                </p>
            </a>

            <a href="/chat"
               class="glass quick-card rounded-2xl p-5">
                <div class="w-11 h-11 rounded-xl bg-purple-500/10
                            flex items-center justify-center text-2xl mb-4">
                    💬
                </div>
                <h3 class="font-semibold">AI Chat</h3>
                <p class="text-sm text-slate-400 mt-1">
                    Chat with AI assistant
                </p>
            </a>

            <a href="/calls"
               class="glass quick-card rounded-2xl p-5">
                <div class="w-11 h-11 rounded-xl bg-cyan-500/10
                            flex items-center justify-center text-2xl mb-4">
                    📞
                </div>
                <h3 class="font-semibold">Call History</h3>
                <p class="text-sm text-slate-400 mt-1">
                    View AI call records
                </p>
            </a>

        </div>

        <!-- STATS -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Total Users</p>
                <div id="users" class="text-3xl font-bold mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Total Calls</p>
                <div id="calls" class="text-3xl font-bold text-blue-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Total Chats</p>
                <div id="chats" class="text-3xl font-bold text-purple-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Total Agents</p>
                <div id="agents" class="text-3xl font-bold text-green-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Knowledge Files</p>
                <div id="knowledge" class="text-3xl font-bold text-yellow-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Today's Calls</p>
                <div id="todayCalls" class="text-3xl font-bold text-cyan-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Today's Chats</p>
                <div id="todayChats" class="text-3xl font-bold text-pink-400 mt-2">--</div>
            </div>

            <div class="glass stat-card rounded-2xl p-5">
                <p class="text-slate-400 text-sm">Avg Duration</p>
                <div id="averageDuration" class="text-3xl font-bold text-orange-400 mt-2">--</div>
            </div>

        </div>

        <!-- ANALYTICS -->
        <div class="grid lg:grid-cols-3 gap-5 mb-8">

            <!-- Weekly Calls -->
            <div class="glass section-card rounded-2xl p-6">

                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h3 class="font-semibold text-lg">Weekly Calls</h3>
                        <p class="text-xs text-slate-500 mt-1">
                            Calls per day (last 7 days)
                        </p>
                    </div>

                    <span class="text-blue-400 text-xs
                                 bg-blue-500/10 px-3 py-1 rounded-full">
                        Live
                    </span>
                </div>

                <div class="h-52">
                    <canvas id="weeklyChart"></canvas>
                </div>

            </div>

            <!-- AI Usage -->
            <div class="glass section-card rounded-2xl p-6
                        flex flex-col justify-center items-center text-center">

                <div class="text-slate-400 text-sm">
                    Call Outcomes
                </div>

                <div class="relative my-4 w-full max-w-[10rem]">
                    <canvas id="statusChart"></canvas>
                </div>

                <p class="text-slate-400 text-sm">
                    Completed vs Pending vs Failed
                </p>

                <span id="statusLegend" class="mt-3 text-xs text-slate-400
                             bg-white/5 px-3 py-1 rounded-full"></span>

            </div>

            <!-- System Status -->
            <div class="glass section-card rounded-2xl p-6">

                <h3 class="font-semibold text-lg mb-6">
                    System Status
                </h3>

                <div class="space-y-4">

                    <div class="flex items-center justify-between
                                p-3 rounded-xl bg-white/[.025]">
                        <span class="text-slate-300">API Server</span>
                        <span class="text-green-400 text-sm">
                            🟢 Online
                        </span>
                    </div>

                    <div class="flex items-center justify-between
                                p-3 rounded-xl bg-white/[.025]">
                        <span class="text-slate-300">MongoDB</span>
                        <span class="text-green-400 text-sm">
                            🟢 Connected
                        </span>
                    </div>

                    <div class="flex items-center justify-between
                                p-3 rounded-xl bg-white/[.025]">
                        <span class="text-slate-300">AI Engine</span>
                        <span class="text-green-400 text-sm">
                            🟢 Active
                        </span>
                    </div>

                </div>

            </div>

        </div>

        <!-- RECENT SECTIONS -->
        <div class="grid lg:grid-cols-2 gap-5">

            <!-- Recent Calls -->
            <div class="glass section-card rounded-2xl p-6">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-semibold">Recent Calls</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Latest call activity
                        </p>
                    </div>

                    <a href="/calls"
                       class="text-sm text-blue-400 hover:text-blue-300">
                        View all →
                    </a>
                </div>

                <div id="recentCalls" class="space-y-4">
                    <p class="text-slate-500 text-sm">Loading...</p>
                </div>
            </div>

            <!-- Recent Chats -->
            <div class="glass section-card rounded-2xl p-6">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-semibold">Recent Chats</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Latest AI conversations
                        </p>
                    </div>

                    <a href="/chat"
                       class="text-sm text-blue-400 hover:text-blue-300">
                        View all →
                    </a>
                </div>

                <div id="recentChats" class="space-y-4">
                    <p class="text-slate-500 text-sm">Loading...</p>
                </div>
            </div>

            <!-- Agents -->
            <div class="glass section-card rounded-2xl p-6">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-semibold">AI Agents</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Active AI assistants
                        </p>
                    </div>

                    <a href="/agents"
                       class="text-sm text-blue-400 hover:text-blue-300">
                        View all →
                    </a>
                </div>

                <div id="recentAgents" class="space-y-4">
                    <p class="text-slate-500 text-sm">Loading...</p>
                </div>
            </div>

            <!-- Knowledge -->
            <div class="glass section-card rounded-2xl p-6">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-semibold">Latest Knowledge</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Recently added documents
                        </p>
                    </div>

                    <a href="/knowledge"
                       class="text-sm text-blue-400 hover:text-blue-300">
                        View all →
                    </a>
                </div>

                <div id="recentKnowledge" class="space-y-4">
                    <p class="text-slate-500 text-sm">Loading...</p>
                </div>
            </div>

        </div>

    </main>
</div>

<!-- Toast -->
<div id="toast"
     class="fixed top-6 right-6 hidden px-5 py-3 rounded-xl
            text-white font-medium shadow-xl z-50
            transition-all duration-300">
</div>

<script src="/js/dashboard.js"></script>


</body>
</html>
