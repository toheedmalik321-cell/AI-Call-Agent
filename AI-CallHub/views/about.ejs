                radial-gradient(ellipse 70% 40% at 50% 0%, #0f2930 0%, transparent 60%),
                #04070c;
        }
        .font-display { font-family: 'Sora', sans-serif; }
    </style>
</head>

<body class="min-h-screen text-slate-200 px-6">

    <header class="mx-auto max-w-4xl py-8 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-9 h-9 rounded-xl grid place-items-center" style="background:linear-gradient(135deg,#2dd4bf,#10b981)">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" class="w-5 h-5"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Z"/><path d="M21 11h-3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-5Z"/><path d="M3 12V9a6 6 0 0 1 12 0v3"/><path d="M10 22h4"/><path d="M12 19v3"/></svg>
            </div>
            <span class="font-display font-bold text-lg">AI CallHub</span>
        </a>
        <a href="/" class="text-sm text-slate-400 hover:text-white transition">← Back to home</a>
    </header>

    <main class="mx-auto max-w-4xl pb-24">
        <h1 class="font-display text-4xl font-bold mb-6">About AI CallHub</h1>

        <div class="space-y-8 text-base leading-relaxed text-slate-300">
            <p>
                AI CallHub started with a simple observation: small and mid-sized businesses lose real money to missed calls.
                A patient calls after clinic hours, a customer rings while your team is busy, a lead goes to voicemail and never calls back.
            </p>
            <p>
                We built AI CallHub so that every incoming call gets answered — by an AI voice agent that sounds natural, knows your business,
                and can book a visit, capture a lead, or handle a support question in seconds. When a human is genuinely needed,
                the call transfers with full context.
            </p>
            <p>
                The platform is designed to be practical: set up a voice in minutes, train it on your own documents and FAQs,
                connect your calendar and CRM, and get a dashboard that shows exactly what happened on every call.
            </p>
            <p>
                AI CallHub is an ongoing project, and we're adding new capabilities all the time. If you have feedback or a use case
                you'd like us to support, <a href="/contact" class="text-teal-300 hover:text-teal-200">we'd love to hear it</a>.
            </p>
        </div>
    </main>

