<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Calls | AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/calls-polish.css">
</head>

<body class="bg-[#070B17] text-white">

<div class="max-w-7xl mx-auto py-10">

   <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">


<div>
    <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-xl">
            📞
        </div>

        <div>
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight">
                Call Management
            </h1>

            <p class="text-slate-400 mt-1">
                Manage and review your AI voice call records.
            </p>
        </div>
    </div>
</div>

<a
    href="/add-call"
    class="inline-flex items-center justify-center gap-2
           bg-gradient-to-r from-blue-600 to-blue-500
           hover:from-blue-500 hover:to-blue-400
           px-6 py-3.5 rounded-xl
           font-semibold
           shadow-lg shadow-blue-500/20
           hover:shadow-blue-500/40
           hover:-translate-y-0.5
           transition-all duration-300">

    <span>＋</span>
    <span>Add Call</span>

</a>


</div>

<!-- Call Stats -->

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">


<div class="glass rounded-2xl p-5 border border-white/10 hover:border-blue-500/20 transition">

    <p class="text-sm text-slate-400">
        Total Calls
    </p>

    <h2 id="totalCallCount" class="text-3xl font-bold mt-2 text-blue-400"></h2>

</div>


<div class="glass rounded-2xl p-5 border border-white/10 hover:border-green-500/20 transition">

    <p class="text-sm text-slate-400">
        Completed
    </p>

    <h2 id="completedCount" class="text-3xl font-bold mt-2 text-green-400"></h2>

</div>


<div class="glass rounded-2xl p-5 border border-white/10 hover:border-yellow-500/20 transition">

    <p class="text-sm text-slate-400">
        Calling
    </p>

    <h2 id="callingCount" class="text-3xl font-bold mt-2 text-yellow-400"></h2>

</div>


<div class="glass rounded-2xl p-5 border border-white/10 hover:border-red-500/20 transition">

    <p class="text-sm text-slate-400">
        Failed
    </p>

    <h2 id="failedCount" class="text-3xl font-bold mt-2 text-red-400"></h2>

</div>


<div class="glass rounded-2xl p-5 border border-white/10 hover:border-cyan-500/20 transition">

    <p class="text-sm text-slate-400">
        Pending
    </p>

    <h2 id="pendingCount" class="text-3xl font-bold mt-2 text-cyan-400"></h2>

</div>

</div>

<!-- Calls Table -->

<div class="glass rounded-3xl overflow-hidden border border-white/10 shadow-xl shadow-black/10">


<!-- Table Header -->

<div class="px-6 py-5 border-b border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

    <div>
        <h2 class="text-lg font-semibold">
            Recent Calls
        </h2>

        <p class="text-sm text-slate-500 mt-1">
            View your latest AI call activity.
        </p>
    </div>

    <div class="flex items-center gap-2 text-xs text-slate-500">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        Live call records
    </div>

</div>


<!-- Responsive Table -->

<div class="overflow-x-auto">

    <table class="w-full min-w-[750px]">

        <thead class="bg-white/[0.025] border-b border-white/10">

            <tr>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                    Customer
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                    Phone Number
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                    Status
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                    Duration
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                    Actions
                </th>

            </tr>

        </thead>


        <tbody id="callsTable" class="divide-y divide-white/[0.06]">

            <tr>

                <td colspan="5" class="px-6 py-14 text-center">

                    <div class="flex flex-col items-center justify-center">

                        <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-2xl mb-4">
                            📞
                        </div>

                        <p class="text-slate-300 font-medium">
                            Loading calls...
                        </p>

                        <p class="text-slate-500 text-sm mt-1">
                            Please wait while your call records are loaded.
                        </p>

                    </div>

                </td>

            </tr>

        </tbody>

    </table>

</div>


</div>

    <script src="/js/toast.js"></script>
<script src="/js/calls.js"></script>

</body>
</html>