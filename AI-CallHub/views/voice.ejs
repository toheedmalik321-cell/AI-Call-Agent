<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Live test your AI voice agent speech before going live.">
    <meta name="theme-color" content="#04070c">
    <link rel="canonical" href="https://ai-call-agent-qlee.onrender.com/voice">
    <meta name="robots" content="noindex, nofollow">
    
    <meta property="og:title" content="Voice Lab — AI CallHub">
    <meta property="og:description" content="Live test your AI voice agent speech before going live.">
    <meta property="og:type" content="website">

    <title>Voice Lab — AI CallHub</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/voice-polish.css">


<link rel="stylesheet" href="/css/app-premium.css"></head>

<body class="bg-slate-900 text-white flex items-center justify-center h-screen">

<div class="app-aurora" aria-hidden="true">
    <div class="app-aurora__blob app-aurora__blob--1"></div>
    <div class="app-aurora__blob app-aurora__blob--2"></div>
</div>
<svg class="app-grain" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="appGrain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#appGrain)"/>
</svg>


    <div class="text-center">

        <h1 class="text-4xl font-bold mb-8">
            AI Voice Assistant
        </h1>

        <button
            id="startBtn"
            class="bg-teal-600 px-8 py-4 rounded-xl text-xl">

            🎤 Start Talking

        </button>

        <p
            id="status"
            class="mt-6 text-xl">

            Ready

        </p>

    </div>

        <script src="/js/toast.js"></script>
<script src="/js/voice.js"></script>


<script src="/js/app-premium.js"></script>
</body>
</html>