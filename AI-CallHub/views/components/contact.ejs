<!-- CTA / CONTACT -->
<section id="contact" class="relative py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-4 lg:px-8 relative z-10">
    <div class="glass rounded-3xl p-8 lg:p-16 relative overflow-hidden" data-aos="zoom-in">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full" style="background:radial-gradient(circle, rgba(168,85,247,0.3), transparent 70%); filter:blur(60px)"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full" style="background:radial-gradient(circle, rgba(91,140,255,0.25), transparent 70%); filter:blur(80px)"></div>

      <div class="grid lg:grid-cols-2 gap-10 relative">
        <div>
          <div class="inline-block text-xs uppercase tracking-widest text-purple-400 mb-3">Let's talk</div>
          <h2 class="font-display text-4xl lg:text-5xl font-bold mb-4">Start automating <span class="text-gradient">today</span></h2>
          <p class="text-slate-300 text-lg mb-8 leading-relaxed">Book a personalized demo or start a 14-day free trial. Our team will help you get live in under 24 hours.</p>

          <div class="space-y-4 mb-8">
            <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl grid place-items-center" style="background:linear-gradient(135deg,#5b8cff,#a855f7)"><svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg></div><div><div class="text-sm text-slate-400">Email us</div><div class="font-semibold">hello@aicallhub.io</div></div></div>
            <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl grid place-items-center" style="background:linear-gradient(135deg,#a855f7,#ec4899)"><svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div><div><div class="text-sm text-slate-400">Sales</div><div class="font-semibold">+1 (800) AI-CALLS</div></div></div>
            <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl grid place-items-center" style="background:linear-gradient(135deg,#22d3ee,#5b8cff)"><svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div><div><div class="text-sm text-slate-400">HQ</div><div class="font-semibold">San Francisco · London · Singapore</div></div></div>
          </div>
        </div>

        <form class="space-y-4" onsubmit="event.preventDefault(); this.querySelector('button').innerText='✓ Message sent — we\\'ll be in touch'; this.querySelector('button').disabled=true;">
          <div class="grid sm:grid-cols-2 gap-3">
            <input required type="text" placeholder="Full name" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400/60 transition"/>
            <input required type="email" placeholder="Work email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400/60 transition"/>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            <input type="text" placeholder="Company" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400/60 transition"/>
            <input type="tel" placeholder="Phone number" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400/60 transition"/>
          </div>
          <textarea placeholder="Tell us about your use case..." rows="4" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-purple-400/60 transition resize-none"></textarea>
          <button type="submit" class="btn-primary w-full rounded-xl py-3.5 font-semibold text-white">Schedule Demo →</button>
          <p class="text-xs text-slate-500 text-center">By submitting you agree to our Privacy Policy. We'll never spam you.</p>
        </form>
      </div>
    </div>
  </div>
</section>