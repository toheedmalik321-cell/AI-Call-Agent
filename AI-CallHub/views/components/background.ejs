
<!-- Premium layered background -->
<div class="premium-aurora" aria-hidden="true">
  <div class="premium-aurora__blob premium-aurora__blob--1"></div>
  <div class="premium-aurora__blob premium-aurora__blob--2"></div>
  <div class="premium-aurora__blob premium-aurora__blob--3"></div>
</div>

<svg class="premium-grain" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
  <filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
  <rect width="100%" height="100%" filter="url(#grain)" opacity="1"/>
</svg>

<canvas class="premium-starfield" aria-hidden="true"></canvas>

<!-- Ambient glows -->
<div class="fixed inset-0 pointer-events-none z-0 bg-grid"></div>
<div class="fixed top-[-10%] left-[-10%] glow-blur w-[500px] h-[500px]" style="background:#2dd4bf"></div>
<div class="fixed top-20 right-[-10%] glow-blur w-[600px] h-[600px]" style="background:#10b981"></div>
<div class="fixed bottom-[-20%] left-[30%] glow-blur w-[700px] h-[700px]" style="background:#fbbf24"></div>
