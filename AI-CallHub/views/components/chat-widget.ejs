<!-- Live Chat Widget (landing) -->
<button id="chatBtn" aria-label="Open chat" class="fixed bottom-6 right-6 z-40 chat-bubble w-14 h-14 rounded-full grid place-items-center text-white hover:scale-110 transition">
  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
</button>

<div id="chatPanel" class="fixed bottom-24 right-6 z-40 hidden glass w-[340px] rounded-2xl overflow-hidden shadow-2xl" style="box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6)">
  <div class="p-4 flex items-center gap-3" style="background:linear-gradient(135deg,#2dd4bf,#10b981)">
    <div class="w-9 h-9 rounded-full bg-white/20 grid place-items-center">
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/></svg>
    </div>
    <div class="text-white">
      <div class="font-semibold text-sm">Aria — AI CallHub Assistant</div>
      <div class="text-xs opacity-80 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-300 call-dot"></span> We reply by email</div>
    </div>
    <button id="chatClose" aria-label="Close chat" class="ml-auto text-white/80 hover:text-white transition">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="p-4 space-y-3 text-sm">
    <div class="flex gap-2">
      <div class="w-7 h-7 rounded-full grid place-items-center flex-none" style="background:linear-gradient(135deg,#2dd4bf,#10b981)"><span class="text-[10px] text-white font-bold">A</span></div>
      <div class="glass rounded-2xl rounded-tl-sm px-3 py-2 text-slate-200">Hi! 👋 Thanks for reaching out. Leave your question below and we'll get back to you by email.</div>
    </div>
  </div>

  <form id="landingChatForm" class="space-y-2 border-t border-white/10 p-3">
    <div class="grid grid-cols-2 gap-2">
      <input id="lcName" type="text" required placeholder="Your name" class="w-full bg-white/5 rounded-lg px-3 py-2 text-sm focus:outline-none border border-white/10 focus:border-teal-400/60"/>
      <input id="lcEmail" type="email" required placeholder="Your email" class="w-full bg-white/5 rounded-lg px-3 py-2 text-sm focus:outline-none border border-white/10 focus:border-teal-400/60"/>
    </div>
    <textarea id="lcMessage" required rows="3" placeholder="How can we help?" class="w-full bg-white/5 rounded-lg px-3 py-2 text-sm focus:outline-none border border-white/10 focus:border-teal-400/60 resize-none"></textarea>
    <button type="submit" class="btn-primary w-full rounded-lg py-2.5 text-white text-sm font-semibold">Send message</button>
    <p id="lcStatus" class="text-center text-xs text-emerald-400 hidden"></p>
  </form>
</div>

<script>
  (function () {
    var btn = document.getElementById('chatBtn');
    var panel = document.getElementById('chatPanel');
    var close = document.getElementById('chatClose');

    function toggle(open) {
      panel.classList.toggle('hidden', !open);
    }
    btn.addEventListener('click', function () { toggle(panel.classList.contains('hidden')); });
    close.addEventListener('click', function () { toggle(false); });
    btn.addEventListener('click', function () { panel.querySelector('#lcName').focus(); });

    var form = document.getElementById('landingChatForm');
    var status = document.getElementById('lcStatus');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = document.getElementById('lcName').value.trim();
      var email = document.getElementById('lcEmail').value.trim();
      var message = document.getElementById('lcMessage').value.trim();

      if (!email || !message) return;

      var submitBtn = form.querySelector('button[type=submit]');
      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending…';
      status.className = 'text-center text-xs text-slate-400';
      status.classList.remove('hidden');
      status.innerText = 'Sending your message…';

      fetch('/api/landing-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, email: email, message: message })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            status.className = 'text-center text-xs text-emerald-400';
            status.innerText = '✓ Message sent — we\'ll reply by email.';
            form.innerHTML = '<p class="text-xs text-slate-300 text-center py-2">Thanks for writing to us. Expect a reply within 1 business day.</p>';
          } else {
            status.className = 'text-center text-xs text-red-400';
            status.innerText = data.message || 'Could not send. Please try again.';
            submitBtn.disabled = false;
            submitBtn.innerText = 'Send message';
          }
        })
        .catch(function () {
          status.className = 'text-center text-xs text-red-400';
          status.innerText = 'Could not send. Please email toheedmalik321@gmail.com directly.';
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send message';
        });
    });
  })();
</script>